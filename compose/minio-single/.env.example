# Copy to .env (git-ignored) and replace every placeholder before scripts/up.sh.
# Never commit .env. Synthetic lab credentials only, never reuse real ones.
MINIO_ROOT_USER=CHANGE_ME_user
MINIO_ROOT_PASSWORD=CHANGE_ME_at_least_8_chars

