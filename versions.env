# Pinned versions for the whole lab. Single source of truth: Compose files,
# scripts and docs read these values. Never use a floating tag such as latest.
# Digests recorded 2026-10-11 with `docker buildx imagetools inspect`.

# MinIO server: last open-source release. Upstream published it as source only
# (no binaries, no image), so we build it ourselves (images/minio/Dockerfile)
# and push the result to a registry we control.
MINIO_RELEASE=RELEASE.2025-10-15T17-29-55Z
MINIO_COMMIT=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a
MINIO_IMAGE=ghcr.io/ooseni/minio:RELEASE.2025-10-15T17-29-55Z
# Digest of the image as pushed to GHCR on 2026-10-11. Compose uses the tag so a
# local rebuild still works; compare against this digest to confirm the image.
MINIO_IMAGE_DIGEST=sha256:0a683d8646a28e03f3d7825c66b2eb53786b6c1c4f74c02610b1f6bca336d8b9

# Upstream MinIO client baked into the MinIO image (official signed binary,
# last mc release with published binaries).
MC_RELEASE=RELEASE.2025-08-13T08-35-41Z

# Silo server (classic image, not -distroless; see docs/01-repo-versions-and-lab).
SILO_RELEASE=RELEASE.2026-09-16T00-00-00Z
SILO_IMAGE=docker.io/pgsty/silo:RELEASE.2026-09-16T00-00-00Z@sha256:635197cb9f36d01bee221d34d1c7d7960f6a95c48b0b6c01d99cd13bdae51a46

# Silo client (mcli, fork of mc).
MCLI_RELEASE=RELEASE.2026-09-16T00-00-00Z
MCLI_IMAGE=docker.io/pgsty/mc:RELEASE.2026-09-16T00-00-00Z@sha256:cfc83108c3abb371f8fb84d99c1fdc88f8c237e022409b0081fb7c0a3be634dd

# Benchmark tool.
WARP_IMAGE=docker.io/minio/warp:v1.3.1@sha256:72ae1b02216b51bd102b73a6923b597c092a5acc7a655c936c2f31bee897a7c5

# Shared Docker network for every Compose project.
LAB_NETWORK=migration-net
